*.lv.ulikecam.com = server:https://dns.alidns.com/dns-query,https://doh.pub/dns-query
lf3-s.vlabstatic.com = server:https://dns.alidns.com/dns-query,https://doh.pub/dns-query
lf3-lv-buz.vlabstatic.com = server:https://dns.alidns.com/dns-query,https://doh.pub/dns-query
